{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SecureGateDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SecureGate.Api",
    "Audience": "SecureGate.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Nvr": {
    "IsapiPort": 80,
    "FfmpegPath": "ffmpeg",
    "SearchTimeoutSeconds": 15,
    "PlaybackStartTimeoutSeconds": 20,
    "MaxDownloadHours": 4,
    "MaxSearchDays": 7
  },
  "Camera": {
    "TargetFps": 25,
    "MaxDrainFrames": 4,
    "SnapshotTimeoutSeconds": 8,
    "FfmpegOptions": "rtsp_transport;tcp|stimeout;5000000|fflags;nobuffer|flags;low_delay|max_delay;500000|reorder_queue_size;0"
  },
  "FaceRecognition": {
    "DetectionIntervalMs": 300,
    "TurnstileCooldownSeconds": 2,
    "RegularCooldownSeconds": 3,
    "CameraRefreshSeconds": 30,
    "SnapshotRetentionDays": 30,
    "SnapshotMaxWidth": 640,
    "SnapshotJpegQuality": 75
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:51985",
      "http://localhost:51985"
    ]
  }
}
