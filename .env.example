# SecureGate — Docker uchun muhit o'zgaruvchilari.
# Foydalanish: `cp .env.example .env` va qiymatlarni o'zgartiring.

# SQL Server (Azure SQL Edge) `sa` paroli.
# Talab: kamida 8 belgi, katta+kichik harf, raqam va maxsus belgi.
MSSQL_SA_PASSWORD=SecureGate_Str0ng!Pass

# JWT imzo kaliti. Bu qiymat git'da ochiq turadi — FAQAT lokal ishlab chiqish uchun.
# PRODUCTION'da ALBATTA almashtiring (kamida 32 bayt):
#   openssl rand -base64 48
JWT_KEY=dev-only-insecure-key-CHANGE-IN-PRODUCTION-0123456789abcdef

# ASP.NET Core muhiti. Development — Swagger + batafsil xatolar.
ASPNETCORE_ENVIRONMENT=Development

# Kamera oqimi / yuz tanish fon xizmati (OpenCV + ONNX).
# Kamera bo'lmagan lokal demoda `false` qilsangiz startup tezlashadi.
FACE_RECOGNITION_ENABLED=true

# Birinchi ishga tushishda yaratiladigan SuperAdmin hisobi.
# Bo'sh qoldirsangiz IdentitySeeder tasodifiy kuchli parol generatsiya qiladi
# va uni ilova logiga yozadi (`docker compose logs app`).
SEEDER_SUPERADMIN_EMAIL=superadmin@securegate.local
SEEDER_SUPERADMIN_PASSWORD=ChangeMe123!
